// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Probe {
    id  Int @id
    latitude Float
    longitude Float
}

model TraceRoute {
    id Int @id
    domain String
    probes Int
    results Json
}

model IpLocation {
    ip          String   @id
    latitude    Float?
    longitude   Float?
    city        String?
    countryCode String?
    resolved    Boolean  @default(false)
    updatedAt   DateTime @updatedAt
}

model Ping {
    id Int @id
    domain String
    probes Int
    result Json
}
